# ==============================================================================
# Vynalth Dictionary — Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit real secrets or production database credentials to Git.
# ==============================================================================

# Optional PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS)
# When omitted or unreachable, structured entries use the starter dataset.
# The bundled multilingual indexes do not require PostgreSQL.
DATABASE_URL=""

# Canonical origin for SEO, e.g. https://your-domain.example (no path).
# Set this to the real Production domain; otherwise Vercel's exposed system URL is used.
# Vercel Preview deployments are marked noindex separately.
NEXT_PUBLIC_SITE_URL=""

# Optional token required to authorize administrative import webhooks (if enabled)
LEXICON_ADMIN_TOKEN=""
