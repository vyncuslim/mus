# ==============================================================================
# Vynalth Lexicon — Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit real secrets or production database credentials to Git.
# ==============================================================================

# Optional PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS)
# When omitted or unreachable, Vynalth Lexicon automatically operates in
# Read-Only Verified Starter Dataset mode without failure.
DATABASE_URL=""

# Canonical public URL used for SEO metadata, canonical tags, sitemap, and OpenGraph
NEXT_PUBLIC_SITE_URL="https://vynalth-lexicon.vercel.app"

# Optional token required to authorize administrative import webhooks (if enabled)
LEXICON_ADMIN_TOKEN=""
